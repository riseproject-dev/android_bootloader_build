# Factory Mode Configuration for U-Boot
# Enable features needed for factory flashing and testing

# AVB (Android Verified Boot) support
CONFIG_LIBAVB=y
CONFIG_AVB_VERIFY=y
CONFIG_AVB_BUF_ADDR=0x11000000
CONFIG_AVB_BUF_SIZE=0x10000000
CONFIG_CMD_AVB=y

# Enable additional debug output in factory mode
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=7
CONFIG_LOG_MAX_LEVEL=9

# Enable factory test commands
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_I2C=y
CONFIG_CMD_SPI=y
CONFIG_CMD_USB=y

# USB mass storage for factory flashing
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y

# DFU support for firmware updates
CONFIG_DFU=y
CONFIG_DFU_MMC=y
CONFIG_CMD_DFU=y
