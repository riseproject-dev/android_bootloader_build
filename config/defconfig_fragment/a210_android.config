# Zhihe A210 Android Boot Configuration
# Enable Android boot method support
#
# eMMC is MMC device 0. The fastboot buffer must be within
# the A210 DRAM range, which starts at 0x80000000.

# Standard boot support (required for bootmeth_android)
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTDEV_BLOCK=y

# Android Boot Image support
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_ABOOTIMG=y
CONFIG_CMD_BOOTI=y

# Android A/B partition support
CONFIG_ANDROID_AB=y

# BCB (Boot Control Block) support
CONFIG_CMD_BCB=y

# Android boot method
# Runtime env vars bootmeths=android and boot_targets=mmc0
# restrict scanning to Android-only on eMMC
CONFIG_BOOTMETH_ANDROID=y

# Fastboot support (already in base config, but ensure it's enabled)
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x91000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_FASTBOOT_CMD_OEM_FORMAT=y

# GPT partition support
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_TYPE_GUID=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_GPT=y
CONFIG_CMD_GPT_RENAME=y

# MMC support for eMMC boot
CONFIG_MMC=y
CONFIG_CMD_MMC=y
CONFIG_SUPPORT_EMMC_BOOT=y

# Command line support
CONFIG_CMDLINE=y

# Boot command for Android
CONFIG_USE_BOOTCOMMAND=y
# Use bootflow scan to detect Android boot
CONFIG_BOOTCOMMAND="bootflow scan -lb"

# Increase kernel load size for Android
CONFIG_SYS_BOOTM_LEN=0x10000000

# AVB loads full boot.img (40MB) + vendor_boot (32MB) into heap for hash verification
CONFIG_SYS_MALLOC_LEN=0x6000000

# Environment for Android
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0

# Disable redundant environment
CONFIG_SYS_REDUNDAND_ENVIRONMENT=n

# Match the validated A210 boot configuration without U-Boot AVB verification.
# CONFIG_LIBAVB is not set
# CONFIG_AVB_VERIFY is not set
# CONFIG_CMD_AVB is not set
